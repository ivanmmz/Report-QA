{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default capability for the main window",
    "windows": [
        "main"
    ],
    "permissions": [
        "core:default",
        "dialog:default",
        {
            "identifier": "fs:default",
            "allow": [
                {
                    "path": "**"
                }
            ]
        },
        {
            "identifier": "fs:read-dirs",
            "allow": [
                {
                    "path": "**"
                }
            ]
        },
        {
            "identifier": "fs:read-files",
            "allow": [
                {
                    "path": "**"
                }
            ]
        },
        {
            "identifier": "fs:write-files",
            "allow": [
                {
                    "path": "**"
                }
            ]
        }
    ]
}